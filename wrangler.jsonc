{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracktime",
  "pages_build_output_dir": ".worker-next",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tracktimer-db",
      "database_id": "tracktimer-db-id"
    }
  ]
}
